!endian("little");
a u16;

!endian("big");
b u16;

inner {
  !endian("little");
  c u16;
};

// parse little endian, because structs don't encapsulate endianness
d u16;

!endian("big");
scope at $offset {
  !endian("little");
  e_le i16;
}

// parsed as big endian because scopes do encapsulate endianness
e_be i16;
