!assert 8KiB == 8 * 1024;
!assert 8KB == 8 * 1000;

!assert 1KiB == 1024;
!assert 1MiB == 1024 * 1024;
!assert 1GiB == 1024 * 1024 * 1024;
!assert 1TiB == 1024 * 1024 * 1024 * 1024;
!assert 1PiB == 1024 * 1024 * 1024 * 1024 * 1024;
!assert 1EiB == 1024 * 1024 * 1024 * 1024 * 1024 * 1024;

!assert 1KB == 1000;
!assert 1MB == 1000 * 1000;
!assert 1GB == 1000 * 1000 * 1000;
!assert 1TB == 1000 * 1000 * 1000 * 1000;
!assert 1PB == 1000 * 1000 * 1000 * 1000 * 1000;
!assert 1EB == 1000 * 1000 * 1000 * 1000 * 1000 * 1000;
