!endian le;

signature bytes = "-FVE-FS-";
size u16;
version u16;
current_state u16;
next_state u16;
encrypted_volume_size u64;
convert_size u32;
num_of_backup_sectors u32;
information_offsets [u64] len 3;
boot_sector_backup u64;

dataset {
    size u32;
    unknown1 u32;
    header_size u32;
    copy_size u32;
    guid bytes len 16;
    next_counter u32;
    algorithm u16;
    trash u16;
    timestamp u64;
};

datums [{
    size u16;
    entry_type enum u16 {
        none = 0x0,
        volume_master_key = 0x2,
        full_volume_encryption_key = 0x3,
        validation = 0x4,
        startup_key = 0x6,
        description = 0x7,
    };
    value_type enum u16 {
        erased = 0x0,
        key = 0x1,
        unicode_string = 0x2,
        stretch_key = 0x3,
        use_key = 0x4,
        aes_ccm_encrypted_key = 0x5,
        tpm_encoded_key = 0x6,
        validation = 0x7,
        volume_master_key = 0x8,
        external_key = 0x9,
        update = 0xa,
        error = 0xb,
        metadata_area_descriptors = 0xf
    };
    error_status u16;
    content switch .value_type {
        _ => bytes len .size - 8,
    };
}] while $offset < .dataset.size + 64;
