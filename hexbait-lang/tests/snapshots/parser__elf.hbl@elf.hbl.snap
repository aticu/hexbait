---
source: hexbait-lang/tests/parser.rs
expression: "ident {\n    magic bytes = <7f \"ELF\">;\n    class enum u8 {\n        ELFCLASSNONE = 0,\n        ELFCLASS32 = 1,\n        ELFCLASS64 = 2,\n    };\n    endianness enum u8 {\n        ELFDATANONE = 0,\n        ELFDATA2LSB = 1,\n        ELFDATA2MSB = 2,\n    };\n    version u8;\n    pad u8;\n    rest_of_ident bytes len 8;\n};\n\nif .ident.endianness == enum.ELFDATA2LSB {\n    !endian(\"little\");\n} else {\n    !endian(\"big\");\n}\n\ntype enum u16 {\n    ET_NONE = 0,\n    ET_REL = 1,\n    ET_EXEC = 2,\n    ET_DYN = 3,\n    ET_CORE = 4,\n    ET_PROC = 0xff00..=0xffff,\n};\nmachine enum u16 {\n    EM_NONE = 0,\n    EM_M32 = 1,\n    EM_SPARC = 2,\n    EM_386 = 3,\n    EM_68K = 4,\n    EM_88K = 5,\n    EM_860 = 7,\n    EM_MIPS = 8,\n    EM_MIPS_RS4_BE = 10,\n    EM_X86_64 = 62,\n    EM_AARCH64 = 183,\n    EM_CUDA = 190,\n    EM_AMDGPU = 224,\n    EM_RISCV = 243,\n    EM_BPF = 247,\n    EM_LOONGARCH = 258,\n};\nversion u32;\nentrypoint u64;\nprogram_header_off u64;\nsection_header_off u64;\nflags u32;\nheader_size u16;\nprogram_header_entry_size u16;\nprogram_header_entry_num u16;\nsection_header_entry_size u16;\nsection_header_entry_num u16;\nsection_header_string_index u16;\n\nlet string_table_start_off = peek(u64 at .section_header_off + .section_header_entry_size * .section_header_string_index + 24);\n\n!seek(to: .section_header_off);\nsections [{\n    name_idx u32;\n    scope at $parent.string_table_start_off + .name_idx {\n        name bytes while peek(u8) != 0;\n    }\n    type enum u32 {\n        SHT_NULL = 0,\n        SHT_PROGBITS = 1,\n        SHT_SYMTAB = 2,\n        SHT_STRTAB = 3,\n        SHT_RELA = 4,\n        SHT_HASH = 5,\n        SHT_DYNAMIC = 6,\n        SHT_NOTE = 7,\n        SHT_NOBITS = 8,\n        SHT_REL = 9,\n        SHT_SHLIB = 10,\n        SHT_DYNSYM = 11,\n        SHT_PROC = 0x70000000..=0x7fffffff,\n        SHT_USER = 0x80000000..=0xffffffff,\n    };\n    flags flags u64 {\n        SHF_WRITE = 0x1,\n        SHF_ALLOC = 0x2,\n        SHF_EXECINSTR = 0x4,\n    };\n    addr u64;\n    offset u64;\n    size u64;\n    link u32;\n    info u32;\n    addr_align u64;\n    entry_size u64;\n\n    scope at .offset {\n        content bytes len .size;\n    }\n}] len .section_header_entry_num;\n"
input_file: format_descriptions/elf.hbl
