expression: "!endian(\"little\");\n\nscope at $offset until 16384 {\n\tchecksum bytes len 32;\n\tfs_uuid bytes len 16;\n\tlogical_address u64;\n\tflags u56;\n\tbackref u8;\n\tchunk_tree_uuid bytes len 16;\n\tgeneration u64;\n\ttree_id u64;\n\tnumber_of_items u32;\n\tlevel u8;\n\n\tnodes switch .level {\n\t\t0 => [{\n\t\t\tobject_id u64;\n\t\t\titem_ty u8;\n\t\t\toffset u64;\n\t\t\tdata_offset u32;\n\t\t\tdata_size u32;\n\n\t\t\tscope at 0x65 + .data_offset until 0x65 + .data_offset + .data_size {\n\t\t\t\tdata switch .item_ty {\n\t\t\t\t\t0x01 => {\n\t\t\t\t\t\tgeneration u64;\n\t\t\t\t\t\ttransid u64;\n\t\t\t\t\t\tsize u64;\n\t\t\t\t\t\tallocated_size u64;\n\t\t\t\t\t\tblock_group u64;\n\t\t\t\t\t\tnlink u32;\n\t\t\t\t\t\tuid u32;\n\t\t\t\t\t\tgid u32;\n\t\t\t\t\t\tmode u32;\n\t\t\t\t\t\trdev u64;\n\t\t\t\t\t\tflags u64;\n\t\t\t\t\t\tsequence u64;\n\t\t\t\t\t\treserved bytes len 32;\n\t\t\t\t\t\tatime u96;\n\t\t\t\t\t\tctime u96;\n\t\t\t\t\t\tmtime u96;\n\t\t\t\t\t\totime u96;\n\t\t\t\t\t},\n\t\t\t\t\t0x0c => {\n\t\t\t\t\t\tindex_in_dir u64;\n\t\t\t\t\t\tname_len u16;\n\t\t\t\t\t\tname bytes len .name_len;\n\t\t\t\t\t},\n\t\t\t\t\t0x18 => {\n\t\t\t\t\t\tkey {\n\t\t\t\t\t\t\tobject_id u64;\n\t\t\t\t\t\t\tty u8;\n\t\t\t\t\t\t\toffset u64;\n\t\t\t\t\t\t};\n\t\t\t\t\t\ttrans_id u64;\n\t\t\t\t\t\tdata_len u16;\n\t\t\t\t\t\tname_len u16;\n\t\t\t\t\t\tty u8;\n\t\t\t\t\t\tname bytes len .name_len;\n\t\t\t\t\t\tdata bytes len .data_len;\n\t\t\t\t\t},\n\t\t\t\t\t0x54 => {\n\t\t\t\t\t\tkey {\n\t\t\t\t\t\t\tobject_id u64;\n\t\t\t\t\t\t\tty u8;\n\t\t\t\t\t\t\toffset u64;\n\t\t\t\t\t\t};\n\t\t\t\t\t\ttrans_id u64;\n\t\t\t\t\t\tdata_len u16;\n\t\t\t\t\t\tname_len u16;\n\t\t\t\t\t\tty u8;\n\t\t\t\t\t\tname bytes len .name_len;\n\t\t\t\t\t\tdata bytes len .data_len;\n\t\t\t\t\t},\n\t\t\t\t\t0x60 => {\n\t\t\t\t\t\tkey {\n\t\t\t\t\t\t\tobject_id u64;\n\t\t\t\t\t\t\tty u8;\n\t\t\t\t\t\t\toffset u64;\n\t\t\t\t\t\t};\n\t\t\t\t\t\ttrans_id u64;\n\t\t\t\t\t\tdata_len u16;\n\t\t\t\t\t\tname_len u16;\n\t\t\t\t\t\tty u8;\n\t\t\t\t\t\tname bytes len .name_len;\n\t\t\t\t\t\tdata bytes len .data_len;\n\t\t\t\t\t},\n\t\t\t\t\t0x6c => {\n\t\t\t\t\t\tgeneration u64;\n\t\t\t\t\t\tsize_of_decoded_extent u64;\n\t\t\t\t\t\tcompression u8;\n\t\t\t\t\t\tencryption u8;\n\t\t\t\t\t\tother_encoding u16;\n\t\t\t\t\t\tty u8;\n\t\t\t\t\t\tcontent switch .ty {\n\t\t\t\t\t\t\t0 => bytes len $parent.data_size - 0x15,\n\t\t\t\t\t\t\t_ => {\n\t\t\t\t\t\t\t\tlogical_address u64;\n\t\t\t\t\t\t\t\tsize_of_extent u64;\n\t\t\t\t\t\t\t\toffset_within_extent u64;\n\t\t\t\t\t\t\t\tlogical_number_of_bytes_in_file u64;\n\t\t\t\t\t\t\t},\n\t\t\t\t\t\t};\n\t\t\t\t\t},\n\t\t\t\t\t0x84 => {\n\t\t\t\t\t\tinode {\n\t\t\t\t\t\t\tgeneration u64;\n\t\t\t\t\t\t\ttransid u64;\n\t\t\t\t\t\t\tsize u64;\n\t\t\t\t\t\t\tallocated_size u64;\n\t\t\t\t\t\t\tblock_group u64;\n\t\t\t\t\t\t\tnlink u32;\n\t\t\t\t\t\t\tuid u32;\n\t\t\t\t\t\t\tgid u32;\n\t\t\t\t\t\t\tmode u32;\n\t\t\t\t\t\t\trdev u64;\n\t\t\t\t\t\t\tflags u64;\n\t\t\t\t\t\t\tsequence u64;\n\t\t\t\t\t\t\treserved bytes len 32;\n\t\t\t\t\t\t\tatime u96;\n\t\t\t\t\t\t\tctime u96;\n\t\t\t\t\t\t\tmtime u96;\n\t\t\t\t\t\t\totime u96;\n\t\t\t\t\t\t};\n\t\t\t\t\t\tgeneration u64;\n\t\t\t\t\t\troot_dir_id u64;\n\t\t\t\t\t\tlogical_address u64;\n\t\t\t\t\t\tbyte_limit u64;\n\t\t\t\t\t\tbytes_used u64;\n\t\t\t\t\t\tlast_snapshot u64;\n\t\t\t\t\t\tflags u64;\n\t\t\t\t\t\trefs u32;\n\t\t\t\t\t},\n\t\t\t\t\t0xe4 => {\n\t\t\t\t\t\tsize_of_chunk u64;\n\t\t\t\t\t\troot_ref u64;\n\t\t\t\t\t\tstripe_len u64;\n\t\t\t\t\t\tty u64;\n\t\t\t\t\t\toptimal_io_align u32;\n\t\t\t\t\t\toptimal_io_width u32;\n\t\t\t\t\t\tmin_io_size u32;\n\t\t\t\t\t\tnumber_of_stripes u16;\n\t\t\t\t\t\tsub_stripes u16;\n\t\t\t\t\t\tstripes [{\n\t\t\t\t\t\t\tdevice_id u64;\n\t\t\t\t\t\t\toffset u64;\n\t\t\t\t\t\t\tdevice_uuid bytes len 16;\n\t\t\t\t\t\t}] len .number_of_stripes;\n\t\t\t\t\t},\n\t\t\t\t\t_ => bytes len .data_size,\n\t\t\t\t};\n\t\t\t}\n\t\t}] len .number_of_items,\n\t\t_ =>