---
source: hexbait-lang/tests/parser.rs
expression: "!endian le;\n\n// assume an entry size of 1024 without knowing anything\n!recover at 1024;\n\nheader {\n    magic bytes = \"FILE\";\n    fixup_value_offset u16;\n    num_fixup_values u16;\n    log_sequence_number u64;\n    sequence_number u16;\n    reference_count u16;\n    first_attribute u16;\n    entry_flags flags u16 {\n        IN_USE = 0x0001,\n        IS_DIRECTORY = 0x0002,\n        IN_EXTEND = 0x0004,\n        IS_VIEW_INDEX = 0x0008,\n    };\n    used_entry_size u32;\n    total_entry_size u32;\n    base_record_file_reference u64;\n    first_attribute_identifier u16;\n\n    !seek to 44;\n    entry_index u32;\n};\n\n!assert .header.first_attribute < .header.used_entry_size;\n!assert .header.used_entry_size <= .header.total_entry_size;\n!assert .header.total_entry_size % 512 == 0;\n!assert .header.num_fixup_values == (.header.total_entry_size / 512) + 1;\n\n// entry sizes larger than 4096 are very uncommon\n!warn if .header.total_entry_size > 4096: \"uncommon header size\";\n\n// now that we know the actual entry size, we can recover more precisely\n!recover at .header.total_entry_size;\n\nlet fixup_value = peek(bytes len 2 at .header.fixup_value_offset);\nlet fixup_values = peek([bytes len 2] len .header.num_fixup_values - 1 at .header.fixup_value_offset + 2);\n\n// check that the fixup values are correct\n!scope at 0 until .header.total_entry_size {\n    _chunks [{\n        !seek by 510;\n        fixup_bytes bytes len 2;\n\n        !warn if .fixup_bytes != $parent.fixup_value: \"fixup value mismatch\";\n    }] len .header.total_entry_size / 512;\n}\n\n// assemble the entry with applied fixup values\n// this is a hack that hard-codes an entry length of 1024, but works with the currently implemented features\n!assert .header.total_entry_size == 1024;\n!scope at 0 until .header.total_entry_size {\n    _first_chunk bytes len 510;\n    let _first_fixup = peek(bytes len 2 at .header.fixup_value_offset + 2);\n    !seek by 2;\n    _second_chunk bytes len 510;\n    let _second_fixup = peek(bytes len 2 at .header.fixup_value_offset + 4);\n    let _parse_buf = concat(._first_chunk, ._first_fixup, ._second_chunk, ._second_fixup);\n}\n\n!scope in ._parse_buf {\n    !seek to .header.first_attribute;\n    attributes [{\n        // attributes are 8 byte aligned\n        !align 8;\n\n        // parse the size first, so the scope and recovery can be defined\n        let _size = peek(u32 at $offset + 4);\n        !recover at $offset + ._size;\n\n        !scope at $offset until $offset + ._size {\n            type enum u32 {\n                STANDARD_INFORMATION = 0x10,\n                ATTRIBUTE_LIST = 0x20,\n                FILE_NAME = 0x30,\n                OBJECT_ID = 0x40,\n                SECURITY_DESCRIPTOR = 0x50,\n                VOLUME_NAME = 0x60,\n                VOLUME_INFORMATION = 0x70,\n                DATA = 0x80,\n                INDEX_ROOT = 0x90,\n                INDEX_ALLOCATION = 0xa0,\n                BITMAP = 0xb0,\n                REPARSE_POINT = 0xc0,\n                EA_INFORMATION = 0xd0,\n                EA = 0xe0,\n                PROPERTY_SET = 0xf0,\n                LOGGED_UTILITY_STREAM = 0x100,\n                USER_DEFINED = 0x1000..=0xfffffffe,\n                END_OF_ATTRIBUTES = 0xffffffff\n            };\n            size u32;\n            nonresident u8;\n            name_size u8;\n            name_offset u16;\n            let name = peek(bytes len .name_size * 2 at .name_offset);\n            attribute_data_flags flags u16 {\n                COMPRESSED = 0x0001,\n                ENCRYPTED = 0x4000,\n                SPARSE = 0x8000,\n            };\n            attribute_identifier u16;\n\n            content switch .nonresident {\n                0 => {\n                    data_size u32;\n                    data_offset u16;\n                    indexed_flag u8;\n                    padding bytes = <00>;\n\n                    !scope at .data_offset until .data_offset + .data_size {\n                        content switch $parent.type {\n                            enum.STANDARD_INFORMATION => {\n                                creation_time u64;\n                                modification_time u64;\n                                changed_time u64;\n                                access_time u64;\n                                file_attribute_flags flags u32 {\n                                    READONLY = 0x00000001,\n                                    HIDDEN = 0x00000002,\n                                    SYSTEM = 0x00000004,\n                                    VOLUME = 0x00000008,\n                                    DIRECTORY = 0x00000010,\n                                    ARCHIVE = 0x00000020,\n                                    DEVICE = 0x00000040,\n                                    NORMAL = 0x00000080,\n                                    TEMPORARY = 0x00000100,\n                                    SPARSE_FILE = 0x00000200,\n                                    REPARSE_POINT = 0x00000400,\n                                    COMPRESSED = 0x00000800,\n                                    OFFLINE = 0x00001000,\n                                    NOT_CONTENT_INDEXED = 0x00002000,\n                                    ENCRYPTED = 0x00004000,\n                                    VIRTUAL = 0x00010000,\n                                    INDEX_VIEW = 0x20000000,\n                                };\n                                maximum_number_of_versions u32;\n                                version_number u32;\n                                class_identifier u32;\n\n                                // some $STANDARD_INFORMATION attributes are 48 bytes and some 72 bytes\n                                !if $parent.data_size > 48 {\n                                    owner_identifier u32;\n                                    security_descriptor_identifier u32;\n                                    quota_charged u64;\n                                    update_sequence_number u64;\n                                }\n                            },\n                            enum.FILE_NAME => {\n                                parent_file_reference u64;\n                                creation_time u64;\n                                modification_time u64;\n                                changed_time u64;\n                                access_time u64;\n                                allocated_file_size u64;\n                                file_size u64;\n                                file_attribute_flags flags u32 {\n                                    READONLY = 0x00000001,\n                                    HIDDEN = 0x00000002,\n                                    SYSTEM = 0x00000004,\n                                    VOLUME = 0x00000008,\n                                    DIRECTORY = 0x00000010,\n                                    ARCHIVE = 0x00000020,\n                                    DEVICE = 0x00000040,\n                                    NORMAL = 0x00000080,\n                                    TEMPORARY = 0x00000100,\n                                    SPARSE_FILE = 0x00000200,\n                                    REPARSE_POINT = 0x00000400,\n                                    COMPRESSED = 0x00000800,\n                                    OFFLINE = 0x00001000,\n                                    NOT_CONTENT_INDEXED = 0x00002000,\n                                    ENCRYPTED = 0x00004000,\n                                    VIRTUAL = 0x00010000,\n                                    INDEX_VIEW = 0x20000000,\n                                };\n                                extended_data u32;\n                                name_string_size u8;\n                                namespace enum u8 {\n                                    POSIX = 0,\n                                    FILE_NAME_NTFS = 1,\n                                    FILE_NAME_DOS = 2,\n                                    DOS_WINDOWS = 3,\n                                };\n                                name bytes len .name_string_size * 2;\n                            },\n                            enum.INDEX_ROOT => {\n                                attribute_type u32;\n                                collation_type u32;\n                                index_entry_size u32;\n                                index_entry_number_of_cluster_blocks u32;\n                                index_node_header {\n                                    index_values_offset u32;\n                                    index_node_size u32;\n                                    allocated_index_node_size u32;\n                                    index_node_flags flags u32 {\n                                        BRANCH = 0x00000001,\n                                    };\n                                };\n                            },\n                            _ => bytes len .data_size,\n                        };\n                    }\n                },\n                _ => {\n                    first_virtual_cluster_number u64;\n                    last_virtual_cluster_number u64;\n                    data_runs_offset u16;\n                    compression_unit_size u16;\n                    padding bytes = <00 00 00 00>;\n                    allocated_data_size u64;\n                    data_size u64;\n                    valid_data_size u64;\n                    !if .compression_unit_size > 0 {\n                        total_allocated_size u64;\n                    }\n\n                    !seek to .data_runs_offset;\n                    data_runs [{\n                        _counts_byte u8;\n\n                        let num_blocks_bytes = ._counts_byte & 0xf;\n                        let block_num_bytes = (._counts_byte >> 4) & 0xf;\n\n                        num_blocks u(.num_blocks_bytes * 8);\n                        block_num i(.block_num_bytes * 8);\n                    }] while peek(u8) != 0;\n                },\n            };\n        }\n        !seek by .size;\n    }] while peek(bytes len 4) != <ff ff ff ff>;\n}\n"
input_file: format_descriptions/mft_entry.hbl
